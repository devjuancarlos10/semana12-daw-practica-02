# Copiar como .env y completar.
# Generar clave: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=reemplazar-por-una-clave-generada
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# 1 = solo permite marcar asistencia dentro de ±2 h del horario del empleado
VALIDAR_HORARIO_MARCACION=1
